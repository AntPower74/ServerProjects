        function DialogPresaVisione(lista, totale) {
            
            // VISUALIZZO L'ULTIMO
            var ultimoIndice = lista.length - 1;
            var attuale = totale - ultimoIndice;

            if (lista[ultimoIndice].Testo !== undefined) {

                idAvviso = lista[ultimoIndice].Id;
                //testoTrim = lista[ultimoIndice].Testo.trim();
                testoTrim = lista[ultimoIndice].Testo;
                chiaveBlob = lista[ultimoIndice].chiaveBlob;
                idDocumento = lista[ultimoIndice].idDocumento;

                if (testoTrim !== "") {


                    var urlCreator = window.URL || window.webkitURL;
                    var imageUrl = urlCreator.createObjectURL(new Blob([new Uint8Array(lista[ultimoIndice].Testo)], { type: "application/pdf" }))                    
                    $("#dialog-confirm-presa-visione").html('<embed src="' + imageUrl +'" type="application/pdf" width="100%" height="100%">');
                    
                    // DIALOG PRESA VISIONE
                    $(function () {


                        heighDialog = screen.availHeight * 0.80;
                        widthDialog = screen.availWidth * 0.80;

                        //removeOverlay();
                        $("#dialog-confirm-presa-visione").dialog({
                            resizable: false,
                            height: heighDialog,
                            width: widthDialog,
                            modal: true,
                            title: "Documenti da visionare " + attuale + "/" + totale,
                            open: function () {                                
                                $('.ui-widget-overlay').addClass('custom-overlay');
                            },
                            close: function (event) {
                                if (event.originalEvent) {
                                    chiusuraDialogConLogOff();
                                    //removeOverlay();
                                }
                            },
                            buttons: {
                                "Letto": function () {

                                    if (chiaveBlob != "") {
                                        SalvaPresaVisioneDocumentoAziendale(idDocumento)
                                    } else {
                                        SalvaPresaVisioneDocumentoDipendente(idDocumento)
                                    }
                                    
                                    $("#dialog-confirm-presa-visione").dialog("close");
                                    lista.splice(ultimoIndice, 1);
                                    if (lista.length > 0) {
                                        DialogPresaVisione(lista, totale);
                                    }

                                    //removeOverlay();
                                },

                                "Annulla": function () {
                                    
                                    chiusuraDialogConLogOff();
                                    //removeOverlay();
                             
                                }
                            }
                        });

                    });

                }
            }

        }

        function chiusuraDialogConLogOff() {            
            $("#dialog-confirm-presa-visione").dialog("close");
            // Devo sloggare
            window.location.href = '/Torino/Account/LogOff';
        }

        function DialogAvvisiBloccanti(lista, totale) {
            
            // VISUALIZZO L'ULTIMO
            var ultimoIndice = lista.length - 1;
            var attuale = totale - ultimoIndice;

            if (lista[ultimoIndice].Testo !== undefined) {

                idAvviso = lista[ultimoIndice].Id;
                testoTrim = lista[ultimoIndice].Testo.trim();

                if (testoTrim !== "") {

                    $("#dialog-confirm").html(lista[ultimoIndice].Testo);

                    // DIALOG AVVISI BLOCCANTI
                    $(function() {

                        $("#dialog-confirm").dialog({
                            resizable: false,
                            height: 500,
                            width: 500,
                            modal: true,
                            title: "Avviso " + attuale + "/" + totale,
                            buttons: {
                                "Letto": function() {

                                    SalvaVistaAvviso(idAvviso);
                                    $("#dialog-confirm").dialog("close");
                                    lista.splice(ultimoIndice, 1);
                                    if (lista.length > 0) {
                                        DialogAvvisiBloccanti(lista, totale);
                                    }
                                },

                                "Annulla": function() {

                                    $("#dialog-confirm").dialog("close");
                                    // Devo sloggare
                                    window.location.href = '/Torino/Account/LogOff';

                                    /*lista.splice(ultimoIndice, 1);
                            if (lista.length > 0) {
                            DialogAvvisiBloccanti(lista, totale);
                            }*/
                                }
                            }
                        });

                    });

                }
            }

        }

        function EsisteVisitaAvviso() {

            // Leggi avviso da mostrare 
            $.post('/Torino/AvvisiBloccantiLettura/LeggiAvvisoDaMostrarePerRuolo',
                   {},
                            function (listaRuoli) {
                                if (listaRuoli.length > 0) {
                                    DialogAvvisiBloccanti(listaRuoli, listaRuoli.length);
                                }
                            }
                        );

        };

        function MostrarePresaVisione() {
            $.post('/Torino/DocumentiPubblicati/GetDocumentiPubblicatiPresaVisione',
                {},
                function (listaDoc) {
                    if (listaDoc.length > 0) {
                       // displayOverlay("");
                        DialogPresaVisione(listaDoc, listaDoc.length);
                    } else {
                        //removeOverlay();
                    }
                }
            );
        }

        function displayOverlay(text) {
            $("<table id='overlay'><tbody><tr><td>" + text + "</td></tr></tbody></table>").css({
                "position": "fixed",
                "top": "0px",
                "left": "0px",
                "width": "100%",
                "height": "100%",
                "background-color": "rgba(0,0,0,.5)",
                "z-index": "10000",
                "vertical-align": "middle",
                "text-align": "center",
                "color": "#fff",
                "font-size": "40px",
                "font-weight": "bold",
                "cursor": "wait"
            }).appendTo("body");
        }

        function removeOverlay() {
            $("#overlay").remove();
        }

