# Hidden directories & System caches
.*
!.gitignore

# Big tools, SDKs & Binaries
android-sdk/
jdk-*/
node-v*/
3d_tools/Godot*
tailscale/
cloudflared
backups/
keystores/
scratch/
__pycache__/

# Dependencies
**/node_modules/
**/venv/
**/.venv/
**/__pycache__/
**/*.py[cod]

# Build outputs
**/dist/
**/build/
**/.next/
**/.nuxt/
**/.gradle/
**/*.apk
**/*.aab
**/*.keystore
**/*.jks

# Logs & Temporary files
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Live databases, secrets & sensitive config
**/*.db
**/*.sqlite*
**/*.sqlite3
**/*credentials*.json
**/*secret*.json
**/*token*.json
**/*.pem
**/*.key
.env
.env*
**/.env
**/.env*

# Archives
*.zip
*.tar.gz
*.tar.xz
*.tgz
